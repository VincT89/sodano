# Pagine generate in build: ogni indirizzo è una cartella con il suo index.html
DirectoryIndex index.html
Options -Indexes

# Countdown del lancio: fino al 1° gennaio 2027 chi apre la home vede prima il countdown, una volta per sessione.
# "Entra nel sito" imposta il cookie sodano_cd e da lì la home è quella vera. Motori di ricerca e anteprime
# dei social vedono sempre la home. %{TIME} è l'ora del server: se il server è in UTC usare 20261231230000.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{TIME} <20270101000000
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)sodano_cd=1
  RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|linkedin|twitter|preview) [NC]
  RewriteRule ^(index\.html)?$ /countdown/index.html [L]
</IfModule>

# Indirizzi inesistenti: pagina "non trovata" del sito (con codice 404)
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
</IfModule>

# Cache: i file in /assets con l'impronta nel nome non cambiano mai; video e immagini cambiano di rado
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(mp4|jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
